{
  "manifest_version": 3,
  "name": "Boletim+ – ferramentas para o RCO",
  "short_name": "Boletim+",
  "version": "0.13.2",
  "description": "Cores, previsão anual, edição de notas e exportação em planilha para o RCO. Extensão independente, sem vínculo com a SEED-PR.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://rco.paas.pr.gov.br/*"
  ],
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_title": "Boletim+: opções",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rco.paas.pr.gov.br/*"
      ],
      "js": [
        "injetado.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rco.paas.pr.gov.br/*"
      ],
      "js": [
        "src/opcoes-padrao.js",
        "src/base.js",
        "src/ponte.js",
        "src/dados.js",
        "src/tabela.js",
        "src/periodos.js",
        "src/avisos.js",
        "src/historico.js",
        "src/exportar.js",
        "src/previsao.js",
        "src/edicao.js",
        "src/estilos.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
